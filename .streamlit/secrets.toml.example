# Copy this file to secrets.toml. Keep real credentials private.
GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-3.5-flash"

# Optional: chat and downloadable summaries work without Twilio.
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"

# session: recipient must have messaged the sender in the last 24 hours.
# template: production sender plus approved template with {{1}} name / {{2}} summary.
WHATSAPP_MODE = "session"
TWILIO_CONTENT_SID = ""
